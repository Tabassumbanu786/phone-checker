// SalesIQ Scripts 2.0 — Message Handler
//
// Paste this into: SalesIQ > Settings > Bot > Zobot > Add > platform "SalesIQ Scripts"
// > code builder > "Message Handler" section (replace the default template code).
//
// The platform provides these variables to this handler automatically:
//   message   (Map)    - message.get("text") is what the visitor typed
//   visitor   (Map)    - visitor details
//   operation (String) - "chat" when the conversation starts, "message" on each reply
//   request   (Map)    - request details
//
// Flow: single-turn bot, no multi-step "context" needed. When the chat starts
// (operation == "chat") or the visitor's message doesn't look like a phone
// number yet, show the prompt. Once a message has 6+ digits in it, send it to
// the phone-checker API and reply with the result.

apiUrl = "https://phone-checker-qdre.vercel.app/api/phone/check";

response = Map();
msg = message.get("text");
digitsOnly = msg.replaceAll("[^0-9]", "");

if(operation.equals("chat") || digitsOnly.length() < 6)
{
	response.put("action", "reply");
	response.put("replies", {"Hi! Send me a phone number (e.g. 415-555-2671) and I'll check whether it's already on file."});
	return response;
}

// GET + query param instead of a POST JSON body: Deluge's invokeUrl does not
// reliably serialize a Map as a raw JSON POST body (a known platform
// limitation), so this avoids that entirely. digitsOnly is used (rather than
// msg) so nothing needs URL-encoding — a literal "+" would get misread as a
// space by the query-string parser, and SalesIQ Scripts doesn't expose
// urlEncode(). The API's DEFAULT_COUNTRY_CODE fills in the country code this
// way, same as if the visitor had typed the number without a "+" prefix.
fullUrl = apiUrl + "?phoneNumber=" + digitsOnly;

apiResponse = invokeUrl
[
	url: fullUrl
	type: GET
];

// SalesIQ Scripts' invokeUrl hands back the parsed JSON body directly (no
// responseCode/responseText wrapper) — apiResponse IS {exists, normalized,
// message} on success or {error} on a validation/rate-limit/server error.
reply = apiResponse.get("error");
if(reply == null)
{
	reply = apiResponse.get("message"); // "Phone number already exists" or "Good to go"
}
if(reply == null)
{
	reply = "Sorry, I couldn't reach the phone lookup service right now. Please try again shortly.";
}

response.put("action", "reply");
response.put("replies", {reply});
return response;
