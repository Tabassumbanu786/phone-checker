# PostgreSQL connection string from Neon (Dashboard > Connection Details).
# Use the pooled connection string for production/deployment.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-west-2.aws.neon.tech/neondb?sslmode=require

# Port the Express server listens on
PORT=4000

# Comma-free single origin allowed to call the API (use your deployed frontend URL in prod)
CORS_ORIGIN=http://localhost:5173

# Default country used to interpret phone numbers with no country code (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=US

# Requests allowed per IP per minute on /api/phone/check
RATE_LIMIT_PER_MINUTE=20
